# ---- Optional: only needed if data/Training Data.csv is missing when running build_artifacts.py
KAGGLE_USERNAME=
KAGGLE_KEY=

# ---- Officer auth  (REPLACE before deployment)
JWT_SECRET=change-me-demo-secret
ADMIN_EMAIL=admin@lendwise.demo
# Plain text or a bcrypt hash ($2b$...)
ADMIN_PASSWORD=Admin@123

# ---- App
DEMO_INTEREST_RATE=10.5
BUSINESS_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=http://localhost:3000
# SQLite (local default) or Postgres. For Supabase use the "Session pooler" URI:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./lendwise.db
MODEL_PATH=app/ml/artifacts/model.pkl
SCALER_PATH=app/ml/artifacts/scaler.pkl
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# ---- Optional: deployment without the model in git
# If model.pkl is missing, download it from this URL on first boot (verify with SHA-256).
MODEL_URL=
MODEL_SHA256=

# ---- Email (optional). Without RESEND_API_KEY, emails are captured in the in-app outbox (demo).
RESEND_API_KEY=
EMAIL_FROM=LendWise <no-reply@lendwise.demo>
EMAIL_REPLY_TO=
# Links inside emails point here (your frontend URL)
PUBLIC_SITE_URL=http://localhost:3000

# ---- Phone OTP (optional). Without Twilio Verify credentials, codes are shown on screen (demo).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
REQUIRE_PHONE_VERIFICATION=true
